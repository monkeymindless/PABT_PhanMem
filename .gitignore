# Môi trường, bộ đệm
.venv/
__pycache__/
*.pyc
.ruff_cache/

# Sản phẩm dựng (bộ cài, exe, gói cập nhật) - dựng lại bằng DUNG_*.bat
build/
dist/
bo_cai/
# bộ cài Visual C++ của Microsoft (~25 MB, tải lại từ Microsoft): giữ trong bo_cai_win\ để dựng bộ cài, không đưa vào lịch sử git
bo_cai_win/*.exe
# bản cập nhật Windows 7 KB3063858 (Microsoft, đóng kèm bộ cài Win7-8): giữ cạnh bộ cài, không đưa vào lịch sử git
bo_cai_win/*.msu

# Dữ liệu thật của người dùng: KHÔNG đưa vào repo (CLAUDE.md)
